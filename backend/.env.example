# Base de datos. En local, el Postgres de docker-compose (puerto host 5433
# para no chocar con otro Postgres en 5432). En producción, el pooler de
# Supabase en modo transacción (puerto 6543).
DATABASE_URL=postgresql://julia:julia123@localhost:5433/julia

# JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-al-menos-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS — URL del frontend en produccion (sin trailing slash)
CORS_ORIGINS=http://localhost:3000

# Storage de fotos (cualquier S3-compatible). Opcional: sin esto la app
# anda completa y los endpoints de fotos responden 503. Con Supabase:
#   STORAGE_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
#   STORAGE_REGION=<región del proyecto, p. ej. us-east-1>
#   STORAGE_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# En local va en true (muestra /docs). En producción se omite o va en
# false: ahí se valida que JWT_SECRET sea seguro.
DEBUG=true
